# Caddy reverse proxy + automaattinen Let's Encrypt -TLS.
# DOMAIN, ACME_EMAIL ja APP_PORT tulevat ympäristöstä (docker-compose).

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip zstd
	reverse_proxy app:{$APP_PORT}

	header {
		# Perusturvaotsikot; sovellus on kokonaan login-seinän takana.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
